# Public website origin, used to validate contact submissions.
CONTACT_SITE_URL=https://ronvargas.dev

# Server-only recipient. Enter your private inbox in .env.local and Vercel.
CONTACT_TO_EMAIL=

# Sender must use a domain verified in Resend.
CONTACT_FROM_EMAIL=Ronald Vargas <contact@ronvargas.dev>
RESEND_API_KEY=

# Turnstile site key is public; the secret stays on the server.
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Shared rate limiting across Vercel instances (standard read/write token).
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
